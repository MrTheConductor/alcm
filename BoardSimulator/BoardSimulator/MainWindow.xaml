<Window x:Class="BoardSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BoardSimulator.ViewModels"
        xmlns:converters="clr-namespace:BoardSimulator.Converters"
        mc:Ignorable="d"
        Title="ALCM Board Simulator" Height="700" Width="900"
        Background="#1E1E1E">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Converters -->
        <converters:BrightnessToOpacityConverter x:Key="BrightnessToOpacityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- VESC Power Indicator LED -->
        <Style x:Key="VescPowerLedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="#444444" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="#552222" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding VescPowered}" Value="True">
                    <Setter Property="Fill" Value="#2ECC40" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2ECC40" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- LED Style -->
        <Style x:Key="LedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Stroke" Value="#444444" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        
        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <!-- Value Label Style -->
        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00D7FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <!-- Slider Style -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#656565" />
                    <Setter Property="Background" Value="#252526" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Footpad Toggle Style - riders press pads on/off, not dial in a
             voltage, so these read as buttons: dark/unpressed, green/pressed -->
        <Style x:Key="FootpadToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,18" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2ECC40" />
                    <Setter Property="Foreground" Value="#000000" />
                    <Setter Property="BorderBrush" Value="#2ECC40" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D7FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact numeric entry (Battery min/max) -->
        <Style x:Key="CompactNumberBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="Foreground" Value="#00D7FF" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Width" Value="55" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Momentary Button Style (for power button) -->
        <Style x:Key="MomentaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00D7FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="30,15" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00D7FF" />
                    <Setter Property="Foreground" Value="#000000" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="ALCM Board Simulator"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#00D7FF"
                   Margin="0,0,0,20" />

        <!-- VESC Power Lost Alert Banner - loud and hard to miss -->
        <Border Grid.Row="1"
                Padding="14,10"
                CornerRadius="4"
                Margin="0,0,0,15"
                Background="#CC0000"
                Visibility="{Binding VescPowerAlert, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VescPowerAlert}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="VescAlertFlash">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.55"
                                                         Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="VescAlertFlash" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⚠ VESC POWER OFF — RIDER SAFETY HAZARD ⚠"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Silence"
                        Command="{Binding SilenceAlarmCommand}"
                        Style="{StaticResource ButtonStyle}"
                        ToolTip="Mute the siren without dismissing the warning" />
            </Grid>
        </Border>

        <!-- Control Panel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource ButtonStyle}" />
            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource ButtonStyle}" />
            <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource ButtonStyle}" />

            <!-- Power Button (Momentary) -->
            <Button Content="⚡ POWER"
                    Style="{StaticResource MomentaryButtonStyle}"
                    Margin="30,5,5,5"
                    PreviewMouseDown="PowerButton_MouseDown"
                    PreviewMouseUp="PowerButton_MouseUp"
                    MouseLeave="PowerButton_MouseLeave"
                    ToolTip="Hold to simulate power button press" />

            <!-- VESC Power Indicator -->
            <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource VescPowerLedStyle}" Margin="0,0,8,0" />
                <TextBlock Text="VESC PWR" Style="{StaticResource LabelStyle}" Margin="0" />
            </StackPanel>

            <TextBlock Text="Time Scale:" Style="{StaticResource LabelStyle}" Margin="30,0,10,0" />
            <Slider Width="150"
                    Minimum="1"
                    Maximum="10"
                    Value="{Binding TimeScale}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding TimeScale, StringFormat={}{0}x}"
                       Style="{StaticResource ValueLabelStyle}"
                       Margin="10,0,0,0" />
        </StackPanel>

        <!-- Main Content - scrollable, since the Inputs column has grown
             taller than a lot of screens/window sizes can show at once -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column - LEDs -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <!-- Status LEDs - 10 RGB LED Array with Diffuser (Glowing Bar) -->
                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Status LEDs (10-LED Array)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15" />
                        <TextBlock Text="Simulates hardware LED array with diffuser" FontSize="11" Foreground="#999999" Margin="0,0,0,10" />
                        
                        <!-- LED Array Bar with Glow Effect -->
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="2" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                            <Grid>
                                <!-- Glow layer (background blur) -->
                                <ItemsControl ItemsSource="{Binding StatusLedArray}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="35" Height="60" Margin="2">
                                                <Rectangle Fill="{Binding DisplayBrush}" RadiusX="4" RadiusY="4">
                                                    <Rectangle.Effect>
                                                        <BlurEffect Radius="15" />
                                                    </Rectangle.Effect>
                                                </Rectangle>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Sharp layer (foreground) -->
                                <ItemsControl ItemsSource="{Binding StatusLedArray}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="35" Height="60" Margin="2">
                                                <Rectangle Fill="{Binding DisplayBrush}" RadiusX="4" RadiusY="4" Opacity="0.8" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        
                        <!-- LED index numbers -->
                        <Grid HorizontalAlignment="Center" Width="390" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                                <ColumnDefinition Width="39" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="1" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="2" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="3" Text="3" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="4" Text="4" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="5" Text="5" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="6" Text="6" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="7" Text="7" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="8" Text="8" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                            <TextBlock Grid.Column="9" Text="9" TextAlignment="Center" Foreground="#666666" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Headlights -->
                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Headlights" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15" />
                        
                        <UniformGrid Columns="2" HorizontalAlignment="Center">
                            <StackPanel Margin="30,5">
                                <Rectangle Fill="{Binding HeadlightFront.DisplayBrush}"
                                           Width="80" Height="30" RadiusX="8" RadiusY="8"
                                           Stroke="#444444" StrokeThickness="2">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="{Binding HeadlightFront.Color}" 
                                                         BlurRadius="20" 
                                                         ShadowDepth="0" 
                                                         Opacity="{Binding HeadlightFront.Brightness, Converter={StaticResource BrightnessToOpacityConverter}}" />
                                    </Rectangle.Effect>
                                </Rectangle>
                                <TextBlock Text="Front" Foreground="#999999" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Margin="30,5">
                                <Rectangle Fill="{Binding HeadlightRear.DisplayBrush}"
                                           Width="80" Height="30" RadiusX="8" RadiusY="8"
                                           Stroke="#444444" StrokeThickness="2">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="{Binding HeadlightRear.Color}" 
                                                         BlurRadius="20" 
                                                         ShadowDepth="0" 
                                                         Opacity="{Binding HeadlightRear.Brightness, Converter={StaticResource BrightnessToOpacityConverter}}" />
                                    </Rectangle.Effect>
                                </Rectangle>
                                <TextBlock Text="Rear" Foreground="#999999" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Right Column - Inputs -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Inputs" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15" />
                    
                    <!-- Footpads -->
                    <TextBlock Text="Footpads" FontSize="16" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,10,0,10" />

                    <UniformGrid Columns="2" Margin="0,5">
                        <ToggleButton Content="Left Pad"
                                      IsChecked="{Binding LeftFootpadPressed}"
                                      Style="{StaticResource FootpadToggleStyle}"
                                      ToolTip="Toggles above/below footpads.c's FOOTPADS_THRESHOLD_ADC (>2.5V)" />
                        <ToggleButton Content="Right Pad"
                                      IsChecked="{Binding RightFootpadPressed}"
                                      Style="{StaticResource FootpadToggleStyle}"
                                      ToolTip="Toggles above/below footpads.c's FOOTPADS_THRESHOLD_ADC (>2.5V)" />
                    </UniformGrid>

                    <!-- VESC Data -->
                    <TextBlock Text="VESC Data" FontSize="16" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,20,0,10" />
                    
                    <!-- VESC Enable Toggle - normally driven by VESC power +
                         boot delay; override lets a tester force it directly -->
                    <CheckBox IsChecked="{Binding VescEnableOverride}"
                              Foreground="#FFAA00"
                              Margin="0,0,0,6">
                        <TextBlock>
                            <Run Text="Override VESC Boot Delay (testing)" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="When off, VESC Enabled below auto-follows VESC power with a ~5s boot delay, like real hardware" FontSize="10" Foreground="#999999" />
                        </TextBlock>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding VescEnabled}"
                              IsEnabled="{Binding VescEnableOverride}"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,10">
                        <TextBlock>
                            <Run Text="VESC Enabled" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="When enabled, VESC messages are sent to ALCM" FontSize="10" Foreground="#999999" />
                        </TextBlock>
                    </CheckBox>
                    
                    <!-- Battery voltage range - editable so the slider matches
                         whatever pack (series count/chemistry) is under test -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Range:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding BatteryVoltageMin, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource CompactNumberBoxStyle}"
                                 ToolTip="Slider minimum (V)" />
                        <TextBlock Grid.Column="2" Text="to" Style="{StaticResource LabelStyle}" Margin="8,0" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding BatteryVoltageMax, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource CompactNumberBoxStyle}"
                                 ToolTip="Slider maximum (V)" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Battery:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="{Binding BatteryVoltageMin}"
                                Maximum="{Binding BatteryVoltageMax}"
                                Value="{Binding BatteryVoltage}"
                                TickFrequency="0.1"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding BatteryVoltage, StringFormat={}{0:F1} V}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Motor RPM:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="-2000"
                                Maximum="2000"
                                Value="{Binding MotorRpm}"
                                TickFrequency="10"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MotorRpm, StringFormat={}{0:F0}}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duty Cycle:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="-100"
                                Maximum="100"
                                Value="{Binding DutyCyclePercent}"
                                TickFrequency="1"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}"
                                ToolTip="Warning >=80%, Danger >=90% (config.h DUTY_CYCLE_WARNING/DANGER_THRESHOLD)" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DutyCyclePercent, StringFormat={}{0:F0}%}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Current:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="-60"
                                Maximum="60"
                                Value="{Binding CurrentAmps}"
                                TickFrequency="1"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}"
                                ToolTip="Battery current (positive = discharging) - feeds IR-drop compensation" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentAmps, StringFormat={}{0:F0} A}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IMU Pitch:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="-90"
                                Maximum="90"
                                Value="{Binding ImuPitch}"
                                TickFrequency="1"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ImuPitch, StringFormat={}{0:F1}°}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IMU Roll:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding ImuRoll}"
                                TickFrequency="1"
                                IsEnabled="{Binding VescEnabled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ImuRoll, StringFormat={}{0:F1}°}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <!-- Fake Phone App (refloat COMMAND_LCM_POLL simulator) -->
                    <TextBlock Text="Phone App (refloat)" FontSize="16" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,20,0,10" />

                    <CheckBox IsChecked="{Binding RefloatInstalled}"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,10">
                        <TextBlock>
                            <Run Text="Refloat Installed" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="When off, the VESC doesn't reply to app data at all" FontSize="10" Foreground="#999999" />
                        </TextBlock>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ExternalLedsEnabled}"
                              IsEnabled="{Binding RefloatInstalled}"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,10">
                        <TextBlock>
                            <Run Text="External LED Module Enabled" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="When off, refloat replies but sends no brightness data" FontSize="10" Foreground="#999999" />
                        </TextBlock>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Locked}"
                              IsEnabled="{Binding RefloatInstalled}"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,10">
                        <TextBlock>
                            <Run Text="Locked" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="refloat app Lock/Unlock (RunState.STATE_DISABLED)" FontSize="10" Foreground="#999999" />
                        </TextBlock>
                    </CheckBox>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Headlight:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding AppHeadlightBrightness}"
                                TickFrequency="1"
                                IsEnabled="{Binding RefloatInstalled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding AppHeadlightBrightness, StringFormat={}{0:F0}%}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status Bar:" Style="{StaticResource LabelStyle}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding AppStatusBrightness}"
                                TickFrequency="1"
                                IsEnabled="{Binding RefloatInstalled}"
                                Style="{StaticResource SliderStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding AppStatusBrightness, StringFormat={}{0:F0}%}"
                                   Style="{StaticResource ValueLabelStyle}" />
                    </Grid>

                    <!-- Quick Actions - each one reliably lands in a specific
                         board_mode.c riding submode (pads + RPM + duty set
                         together), instead of hand-tuning sliders and hoping
                         they land on the right side of a threshold. -->
                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,20,0,10" />

                    <UniformGrid Columns="2" Margin="0,5">
                        <Button Content="Idle (pads up)"
                                Command="{Binding ApplyIdlePresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="Pads up, RPM 0, duty 0%" />
                        <Button Content="Stopped"
                                Command="{Binding ApplyStoppedPresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="Pads down, RPM 0 - BOARD_SUBMODE_RIDING_STOPPED (RPM &lt; STOPPED_RPM_THRESHOLD, 20)" />
                        <Button Content="Riding Slow"
                                Command="{Binding ApplyRidingSlowPresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="RPM 500 - BOARD_SUBMODE_RIDING_SLOW (20 &lt;= RPM &lt; SLOW_RPM_THRESHOLD, 2000)" />
                        <Button Content="Riding Normal"
                                Command="{Binding ApplyRidingNormalPresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="RPM 2500, duty 40% - BOARD_SUBMODE_RIDING_NORMAL" />
                        <Button Content="Duty Warning"
                                Command="{Binding ApplyDutyWarningPresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="Duty 85% - BOARD_SUBMODE_RIDING_WARNING (>= DUTY_CYCLE_WARNING_THRESHOLD, 80%)" />
                        <Button Content="Duty Danger"
                                Command="{Binding ApplyDutyDangerPresetCommand}"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="Duty 95% - BOARD_SUBMODE_RIDING_DANGER (>= DUTY_CYCLE_DANGER_THRESHOLD, 90%)" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="#007ACC" 
                CornerRadius="3" 
                Padding="10" 
                Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="#FFFFFF" 
                       FontSize="14" />
        </Border>
    </Grid>
</Window>
